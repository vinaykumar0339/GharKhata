rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function project(projectId) { return get(/databases/$(database)/documents/projects/$(projectId)); }
    function isMember(projectId) { return signedIn() && request.auth.uid in project(projectId).data.memberIds; }
    function isOwner(projectData) { return signedIn() && projectData.ownerId == request.auth.uid; }
    function isAdmin(projectId) { return isMember(projectId) && (project(projectId).data.ownerId == request.auth.uid || project(projectId).data.memberRoles[request.auth.uid] == 'admin'); }
    function isActive(projectId) { return project(projectId).data.status == 'active'; }
    function canEdit(projectId) { return isActive(projectId) && (isAdmin(projectId) || (isMember(projectId) && project(projectId).data.memberRoles[request.auth.uid] == 'editor')); }
    function acceptedInvite(projectId) { return getAfter(/databases/$(database)/documents/projectInvites/$(projectId + '__' + request.auth.token.email)); }
    function allowedMaster(name) { return name in ['categories', 'stages', 'vendors', 'units', 'paymentMethods', 'paymentStatuses']; }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberRoles[request.auth.uid] == 'admin';
      allow delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && (resource.data.status == 'active' || (request.resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedBy', 'updatedByName', 'updatedAt'])));
      allow update: if isAdmin(projectId)
        && (resource.data.status == 'active' || (request.resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedBy', 'updatedByName', 'updatedAt'])))
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId in request.resource.data.memberIds
        && request.resource.data.memberRoles[resource.data.ownerId] == 'admin'
        && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'houseType', 'location', 'totalBudget', 'currency', 'startDate', 'expectedCompletionDate', 'status', 'memberIds', 'memberRoles', 'updatedBy', 'updatedByName', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.status == 'active'
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles', 'updatedAt'])
        && acceptedInvite(projectId).data.status == 'accepted'
        && acceptedInvite(projectId).data.acceptedBy == request.auth.uid
        && request.resource.data.memberRoles[request.auth.uid] == acceptedInvite(projectId).data.role;

      match /members/{userId} {
        allow read: if isMember(projectId);
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == userId
          && request.resource.data.displayName is string
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'updatedAt'])
          && request.auth.uid in getAfter(/databases/$(database)/documents/projects/$(projectId)).data.memberIds;
        allow update: if signedIn()
          && userId == request.auth.uid
          && isMember(projectId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.displayName is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
        allow delete: if isAdmin(projectId);
      }
    }

    match /projectInvites/{inviteId} {
      allow create: if signedIn() && isAdmin(request.resource.data.projectId) && isActive(request.resource.data.projectId)
        && request.resource.data.ownerId == project(request.resource.data.projectId).data.ownerId;
      allow read, delete: if signedIn() && (isAdmin(resource.data.projectId) || request.auth.token.email == resource.data.invitedEmail);
      allow update: if signedIn() && isAdmin(resource.data.projectId) && isActive(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.invitedEmail == resource.data.invitedEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectName', 'role', 'status', 'acceptedBy', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && request.auth.token.email == resource.data.invitedEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'updatedAt'])
        && ((request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid) || request.resource.data.status == 'declined');
    }

    match /expenses/{id} {
      allow read: if isMember(resource.data.projectId);
      allow create: if canEdit(request.resource.data.projectId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if canEdit(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canEdit(resource.data.projectId);
    }

    match /budgets/{id} {
      allow read: if isMember(id);
      allow create: if id == request.resource.data.projectId && isAdmin(request.resource.data.projectId) && isActive(request.resource.data.projectId);
      allow update: if id == resource.data.projectId && request.resource.data.projectId == resource.data.projectId && isAdmin(resource.data.projectId) && isActive(resource.data.projectId);
      allow delete: if isAdmin(resource.data.projectId) && isActive(resource.data.projectId);
    }

    match /{masterCollection}/{id} {
      allow read: if allowedMaster(masterCollection) && isMember(resource.data.projectId);
      allow create: if allowedMaster(masterCollection) && canEdit(request.resource.data.projectId);
      allow update: if allowedMaster(masterCollection) && canEdit(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId;
      allow delete: if allowedMaster(masterCollection) && canEdit(resource.data.projectId);
    }
  }
}
