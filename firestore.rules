rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId(projectId, userId) { return projectId + '__' + userId; }
    function membership(projectId, userId) { return get(/databases/$(database)/documents/projectMembers/$(membershipId(projectId, userId))); }
    function isMember(projectId) { return signedIn() && exists(/databases/$(database)/documents/projectMembers/$(membershipId(projectId, request.auth.uid))); }
    function isAdmin(projectId) { return isMember(projectId) && membership(projectId, request.auth.uid).data.role == 'admin'; }
    function isActive(projectId) { return get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'active'; }
    function isOwner(projectId) { return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid; }
    function canEdit(projectId) { return isActive(projectId) && isMember(projectId) && membership(projectId, request.auth.uid).data.role in ['admin', 'editor']; }
    function acceptedInvite(projectId) { return getAfter(/databases/$(database)/documents/projectInvites/$(projectId + '__' + request.auth.token.email)); }
    function allowedMaster(name) { return name in ['categories', 'stages', 'vendors', 'units', 'paymentMethods', 'paymentStatuses']; }
    function validMember(data) { return data.keys().hasOnly(['projectId', 'userId', 'role', 'createdAt', 'updatedAt']) && data.projectId is string && data.userId is string && data.role in ['admin', 'editor', 'viewer'] && data.createdAt is string && data.updatedAt is string; }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'currency', 'selectedProjectId', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.currency in ['INR', 'USD']
        && request.resource.data.createdAt is string;
      allow read: if signedIn();
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'currency', 'selectedProjectId'])
        && request.resource.data.displayName is string
        && request.resource.data.currency in ['INR', 'USD'];
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if isMember(projectId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/projectMembers/$(membershipId(projectId, request.auth.uid))).data.projectId == projectId
        && getAfter(/databases/$(database)/documents/projectMembers/$(membershipId(projectId, request.auth.uid))).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/projectMembers/$(membershipId(projectId, request.auth.uid))).data.role == 'admin';
      allow update: if isAdmin(projectId)
        && (resource.data.status == 'active' || request.resource.data.status == 'active')
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'houseType', 'location', 'totalBudget', 'currency', 'startDate', 'expectedCompletionDate', 'status', 'updatedBy', 'updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isOwner(projectId);
    }

    match /projectMembers/{memberId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isMember(resource.data.projectId));
      allow create: if signedIn()
        && validMember(request.resource.data)
        && memberId == membershipId(request.resource.data.projectId, request.resource.data.userId)
        && request.resource.data.userId == request.auth.uid
        && ((getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid && request.resource.data.role == 'admin')
          || (acceptedInvite(request.resource.data.projectId).data.status == 'accepted' && acceptedInvite(request.resource.data.projectId).data.acceptedBy == request.auth.uid && acceptedInvite(request.resource.data.projectId).data.role == request.resource.data.role));
      allow update: if isAdmin(resource.data.projectId)
        && isActive(resource.data.projectId)
        && resource.data.userId != get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);
      allow delete: if isOwner(resource.data.projectId) || (isAdmin(resource.data.projectId) && resource.data.userId != get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId);
    }

    match /projectInvites/{inviteId} {
      allow create: if signedIn() && isAdmin(request.resource.data.projectId) && isActive(request.resource.data.projectId)
        && request.resource.data.keys().hasOnly(['projectId', 'invitedEmail', 'role', 'status', 'createdAt', 'updatedAt']);
      allow read: if signedIn() && (isAdmin(resource.data.projectId) || request.auth.token.email == resource.data.invitedEmail);
      allow delete: if isAdmin(resource.data.projectId) || isOwner(resource.data.projectId);
      allow update: if signedIn() && isAdmin(resource.data.projectId) && isActive(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.invitedEmail == resource.data.invitedEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && request.auth.token.email == resource.data.invitedEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'updatedAt'])
        && ((request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid) || request.resource.data.status == 'declined');
    }

    match /expenses/{id} {
      allow read: if isMember(resource.data.projectId);
      allow create: if canEdit(request.resource.data.projectId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canEdit(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canEdit(resource.data.projectId) || isOwner(resource.data.projectId);
    }

    match /budgets/{id} {
      allow read: if isMember(id);
      allow create: if id == request.resource.data.projectId && isAdmin(request.resource.data.projectId) && isActive(request.resource.data.projectId) && request.resource.data.updatedBy == request.auth.uid;
      allow update: if id == resource.data.projectId && request.resource.data.projectId == resource.data.projectId && isAdmin(resource.data.projectId) && isActive(resource.data.projectId) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isOwner(resource.data.projectId);
    }

    match /{masterCollection}/{id} {
      allow read: if allowedMaster(masterCollection) && isMember(resource.data.projectId);
      allow create: if allowedMaster(masterCollection) && canEdit(request.resource.data.projectId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if allowedMaster(masterCollection) && canEdit(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if allowedMaster(masterCollection) && (canEdit(resource.data.projectId) || isOwner(resource.data.projectId));
    }
  }
}
